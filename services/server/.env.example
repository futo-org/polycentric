# Copy to `.env` and edit for local dev.
#
# Values here are the defaults env var is unset. Locations where the variables
# are used:
#  * services/server/src/config.rs
#  * services/common/object-store/src/lib.rs
#  * services/common/kafka/src/config.rs
#  * services/common/telemetry/src/lib.rs
#  * services/server/tests/src/lib.rs (testing only)
#
# All commented out variables are optional.

#
## Main server env vars
#

# The URL of this polycentric server.
#POLYCENTRIC_SERVER_NAME=http://localhost:3000

# Hosts clients may address this server as, comma-delimited — the audiences
# accepted on auth tokens. Defaults to POLYCENTRIC_SERVER_NAME.
#POLYCENTRIC_ALLOW_HOSTS=http://localhost:3000,http://127.0.0.1:3000

# Postgres database address to connect to.
#DATABASE_URL=postgres://postgres:testing@localhost:5432
# Read-only Postgres database address to connect to.
# If not set we'll not use a separate connection pool for read-only queries.
#DATABASE_URL_RO=
# For local testing the `default_transaction_read_only` can be set to on. This
# is not required to run.
#DATABASE_URL_RO=postgres://postgres:testing@localhost:5432?options=-c%20default_transaction_read_only=on

# Maximum size of the Postgres connection pool.
#POLYCENTRIC_DATABASE_MAX_CONNECTIONS=100

# Public URL clients should use when fetching blob bodies. Reported by
# ServerService.GetInfo → ServerInfo.cdn_url.
#CDN_URL=http://localhost:3000

# Internal scraper service (services/scraper) used to fetch link-preview
# metadata (UrlInfo) and proxy preview images (/image_proxy).
#POLYCENTRIC_SCRAPER_URL=http://localhost:8855

# Identity of the moderation service we apply labels from.
#POLYCENTRIC_MODERATION_IDENTITY=...
# When running the integration tests use the following.
#POLYCENTRIC_MODERATION_IDENTITY=020225a394cac01413ff43527f1644b1772d78d2cea873de1e8ae2f9c3c9f47b

# Overwrite the gravity value used in the reaction_count_decay function.
# Essentially the higher the number the larger the impact of the decay.
# Defaults to using a dynamic value based on the current posts and reactions.
#POLYCENTRIC_FEEDS_GRAVITY=
# Values used to dynamically compute the gravity value.
# The gravity value per reaction considered.
#POLYCENTRIC_FEEDS_GRAVITY_PER_REACTION=0.0005
# The amount of hours to consider reactions.
#POLYCENTRIC_FEEDS_GRAVITY_HOURS=24
# How often the decayed reaction counts should be updated, in seconds.
#POLYCENTRIC_FEEDS_GRAVITY_COUNTS_UPDATE_FREQUENCY_SECS=300

#
## Object store client env vars
#

# S3 bucket where uploaded blob bodies are stored. Objects are keyed by
# `{digest_type}_{hex(digest_value)}`.
CONTENT_BLOB_OS_BUCKET=polycentric-blobs

# Region the bucket lives in.
# CONTENT_BLOB_OS_REGION=us-east-1

# Custom endpoint URL for S3-compatible stores. Defaults to for AWS S3.
# CONTENT_BLOB_OS_ENDPOINT=http://localhost:9000

# Set to `true` for path-style addressing.
# Required by RustFS.
# CONTENT_BLOB_OS_FORCE_PATH_STYLE=false

# Static credentials for the blob store. If unset, the AWS SDK's default chain
# is used (shared config, container/EC2 metadata).
# CONTENT_BLOB_OS_ACCESS_KEY=...
# CONTENT_BLOB_OS_SECRET_KEY=...

#
## Kafka client env vars
#

# Value of bootstrap.servers.
#POLYCENTRIC_KAFKA_BROKERS=localhost:9092
# Value of security.protocol.
#POLYCENTRIC_KAFKA_SECURITY_PROTOCOL=PLAINTEXT

# SASL settings.
# sasl.mechanism
#POLYCENTRIC_KAFKA_SASL_MECHANISM=...
# sasl.username
#POLYCENTRIC_KAFKA_SASL_USERNAME=...
# sasl.password
#POLYCENTRIC_KAFKA_SASL_PASSWORD=...

# TLS client authentication settings.
# ssl.ca.pem
#POLYCENTRIC_KAFKA_SSL_CA=...
# ssl.certificate.pem
#POLYCENTRIC_KAFKA_SSL_CERTIFICATE=...
# ssl.key.pem
#POLYCENTRIC_KAFKA_SSL_KEY=...

# Value of broker.address.family.
#POLYCENTRIC_KAFKA_BROKER_ADDRESS_FAMILY = "any"

# Prefix to allow the broken to be shared. Defaults to no prefix.
#POLYCENTRIC_KAFKA_CLUSTER_ID=...

# Valud of auto.offset.reset.
#POLYCENTRIC_KAFKA_AUTO_OFFSET_RESET=latest

#
## Telemetry env vars
#

# Either "json" or "text". Defaults to text if stdout is a terminal.
#LOG_FORMAT=

# Level to use when logging.
#RUST_LOG=info

# Port to serve metrics on.
#METRICS_PORT=9464

#
## Integration tests env vars
#

# Address where the tests expect the server to listen on.
#POLYCENTRIC_TEST_SERVER=http://localhost:3000

#
## Makefile
#

# The makefile uses the following variables to connect to Postgres.
# NOTE: these have to be set explicitly to work and should match DATABASE_URL.
#DB_PASSWORD=testing
#DB_NAME=postgres
#DB_HOST=localhost
#DB_PORT=5432
#DB_USER=postgres
